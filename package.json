{
  "name": "ldgenx-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check:html": "node scripts/check-html.mjs",
    "check:http": "node scripts/check-http.mjs",
    "typography": "node scripts/fr-typography.mjs",
    "check:typography": "node scripts/fr-typography.mjs --check",
    "check:assays": "node scripts/build-assay-targets.mjs --check",
    "check:seo": "node scripts/check-seo.mjs",
    "check:content": "node scripts/check-launch-content.mjs",
    "check:client-changes": "node scripts/check-client-changes.mjs",
    "check:final-review": "node scripts/check-final-review.mjs",
    "check:media": "node scripts/check-equipment-media.mjs",
    "check:launch-browser": "node scripts/check-launch-browser.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "audit:publications": "node scripts/audit-publication-sources.mjs",
    "supabase:setup": "node scripts/setup-supabase.mjs",
    "supabase:deploy": "node scripts/deploy-supabase.mjs",
    "supabase:admin-link": "node scripts/admin-link.mjs",
    "check:backend": "deno check supabase/functions/portal/index.ts",
    "test:portal": "deno test tests/portal.test.ts",
    "check:supabase": "node scripts/check-supabase.mjs",
    "check:portal-browser": "node scripts/check-portal-browser.mjs",
    "check:account-browser": "node scripts/check-account-browser.mjs",
    "check:portal-origins": "node scripts/check-portal-origins.mjs",
    "supabase:email": "node scripts/configure-supabase-email.mjs",
    "supabase:production-domain": "node scripts/configure-production-domain.mjs",
    "check:production-config": "node scripts/check-production-config.mjs",
    "check:production-domain": "node scripts/check-production-domain.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.1.13",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "deno": "^2.9.6",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "postgres": "^3.4.7",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7"
  }
}
